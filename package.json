{
  "name": "hangover-reef",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n server,client \"PUBLIC_URL=http://localhost:5173 tsx watch server/index.ts\" \"vite\"",
    "e2e": "node scripts/e2e.mjs",
    "test:security": "node scripts/security-test.mjs",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "start": "tsx server/index.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^9.6.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/ws": "^8.18.2",
    "concurrently": "^9.2.5",
    "playwright-core": "^1.64.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  },
  "dependencies": {
    "@fontsource/lilita-one": "^5.3.0",
    "@fontsource/nunito": "^5.3.0",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "express": "^5.3.0",
    "pg": "^8.23.1",
    "pixi.js": "^8.22.0",
    "stripe": "^23.0.0",
    "tsx": "^4.23.15",
    "ws": "^8.22.0"
  },
  "optionalDependencies": {
    "better-sqlite3": "^11.10.0"
  },
  "engines": {
    "node": ">=20.12 <23"
  }
}
