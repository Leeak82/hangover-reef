# Copy to .env (or export these) before starting the server.
PORT=8787
# Public URL players use; Stripe redirects back here after checkout.
PUBLIC_URL=http://localhost:8787
# Postgres (production). Leave empty to use the local SQLite file below.
DATABASE_URL=
DB_PATH=./data/hangover-reef.sqlite
# Long random string; keys the stored session-token hashes
SESSION_SECRET=

# Stripe (leave empty for dev mode: the shop then credits test coins with no payment)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Optional
# ALLOW_TEST_PURCHASES=true   # keep free test purchases on in production while Stripe is not set (test builds only)
# BOSS_FIRST_MS=3000      # make the first whale show up sooner (testing/screenshots)
# ALLOWED_ORIGINS=https://my-other-domain.com   # extra origins allowed to open the game socket
